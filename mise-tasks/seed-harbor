#!/usr/bin/env bash
#MISE description="Build and seed local Harbor with placeholder HTTP image"
set -euo pipefail

HARBOR_URL="${HARBOR_URL:-localhost:30002}"
HARBOR_USER="${HARBOR_USER:-admin}"
HARBOR_PASSWORD="${HARBOR_PASSWORD:-Harbor12345}"
TARGET="${HARBOR_URL}/library/placeholder:latest"

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

cat > "$TMPDIR/main.go" <<'EOF'
package main

import (
	"fmt"
	"net/http"
	"os"
)

func main() {
	port := os.Getenv("PORT")
	if port == "" {
		port = "8080"
	}
	http.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
		fmt.Fprintln(w, "ok")
	})
	_ = http.ListenAndServe(":"+port, nil)
}
EOF

cat > "$TMPDIR/Dockerfile" <<'EOF'
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY main.go .
RUN CGO_ENABLED=0 go build -ldflags="-w -s" -o /placeholder main.go

FROM scratch
COPY --from=build /placeholder /placeholder
ENTRYPOINT ["/placeholder"]
EOF

echo "Building and seeding ${TARGET} in Harbor..."
docker build -t "${TARGET}" "${TMPDIR}"
echo "${HARBOR_PASSWORD}" | docker login "${HARBOR_URL}" -u "${HARBOR_USER}" --password-stdin
docker push "${TARGET}"
